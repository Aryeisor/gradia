NODE_ENV=development
PUERTO=3000

DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/gradia
# Solo para pruebas de integracion. Debe apuntar exactamente a gradia_test.
DATABASE_URL_TEST=postgresql://usuario:contrasena@localhost:5432/gradia_test

ORIGEN_FRONTEND=http://localhost:5173

JWT_SECRET=reemplazar_por_un_secreto_seguro
JWT_ACCESS_EXPIRACION=15m

REFRESH_TOKEN_DIAS=7
REFRESH_TOKEN_COOKIE=gradia_refresh_token

MAX_INTENTOS_LOGIN=5
MINUTOS_BLOQUEO_LOGIN=15

BCRYPT_COSTO=12

# Opcionales como conjunto: defina ambas o deje ambas ausentes.
# ADMIN_INICIAL_CORREO=administrador@gradia.local
# ADMIN_INICIAL_CONTRASENA=use_una_contrasena_unica_de_12_o_mas_caracteres
